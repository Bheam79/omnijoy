events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout 65;
    client_max_body_size 512m;

    # Compression
    gzip on;
    gzip_vary on;
    gzip_types
        text/plain text/css text/xml text/javascript
        application/json application/javascript application/xml+rss
        image/svg+xml;

    # Backend upstream — uses Docker container name which resolves inside
    # the 07ad0b82_omnijoy_net network.
    upstream backend {
        server 07ad0b82_omnijoy_backend:5000;
        keepalive 32;
    }

    # MinIO upstream — S3-compatible object store. nginx terminates the public
    # /media/ requests and proxies them into the bucket on the internal network.
    upstream minio {
        server 07ad0b82_omnijoy_minio:9000;
        keepalive 32;
    }

    server {
        listen 80;
        server_name _;

        # ── SignalR WebSocket hubs ────────────────────────────────────────────
        # Long timeout — SignalR keeps connections open.
        location /hubs/ {
            proxy_pass         http://backend;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection "Upgrade";
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # ── Media (MinIO object store) ───────────────────────────────────────
        # Objects are content-addressed (UUID-based keys) and never change once
        # written, so we set a 1-year immutable Cache-Control header.
        # The bucket name below is the MINIO_BUCKET env var, substituted by
        # envsubst when the nginx container starts (see the nginx service
        # entrypoint in docker-compose.prod.yml). MINIO_BUCKET in docker/.env
        # is the single source of truth — no manual edits needed here.
        location /media/ {
            proxy_pass         http://minio/${MINIO_BUCKET}/;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_connect_timeout 30s;
            proxy_read_timeout    120s;

            # Hide MinIO-supplied caching/ETag noise so our header wins cleanly.
            proxy_hide_header  Cache-Control;
            proxy_hide_header  X-Amz-Request-Id;
            proxy_hide_header  X-Amz-Id-2;
            proxy_hide_header  X-Amz-Meta-Server-Side-Encryption;
            proxy_ignore_headers Cache-Control Expires Set-Cookie;

            add_header Cache-Control "public, max-age=31536000, immutable" always;

            # MinIO returns 404 on missing keys — let it through unmodified.
            proxy_intercept_errors off;
        }

        # ── Live stream WebSocket ingest ─────────────────────────────────────
        # /api/live/{uuid}/ingest is a raw WebSocket endpoint (browser → FFmpeg →
        # RTMP). It needs the same Upgrade headers as /hubs/ but lives under /api/.
        # Regex locations win over prefix locations, so this takes priority over the
        # general /api/ block below for matching paths.
        location ~ ^/api/live/[^/]+/ingest {
            proxy_pass         http://backend;
            proxy_http_version 1.1;
            proxy_set_header   Upgrade $http_upgrade;
            proxy_set_header   Connection "Upgrade";
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        # ── Prometheus metrics ───────────────────────────────────────────────
        # Internal network only — deny all external traffic.
        # Prometheus should scrape directly from the backend container
        # (port 5000) to bypass this block entirely; this restriction is a
        # defence-in-depth measure in case the port is ever exposed.
        location = /metrics {
            allow  172.0.0.0/8;   # Docker bridge networks (172.16.x.x / 172.17.x.x …)
            allow  10.0.0.0/8;    # Alternative Docker custom networks
            allow  127.0.0.1;
            deny   all;

            proxy_pass         http://backend;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_read_timeout 10s;
        }

        # ── REST API ─────────────────────────────────────────────────────────
        location /api/ {
            proxy_pass         http://backend;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 120s;
        }

        # ── SPA + static files (served by .NET MapFallbackToFile) ─────────────
        location / {
            proxy_pass         http://backend;
            proxy_http_version 1.1;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
