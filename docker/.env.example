# ─────────────────────────────────────────────────────────────────────────────
# Omnijoy — environment variables template
# Copy this file to docker/.env and fill in the values before running make.
#
#   cp docker/.env.example docker/.env
#   $EDITOR docker/.env
#   make prod-up
# ─────────────────────────────────────────────────────────────────────────────

# ── MariaDB ───────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=omnijoy
MYSQL_USER=omnijoy
MYSQL_PASSWORD=change_me_db_password

# ── JWT (minimum 32 characters — used to sign auth tokens) ───────────────────
# Generate a strong secret:  openssl rand -hex 32
JWT_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# ── Public port (host-side port that nginx listens on) ────────────────────────
# Maps to container port 80. Change if 80 is already in use on your server.
PUBLIC_PORT=80

# ── RTMP ingest port for live streaming (OBS → mediamtx) ─────────────────────
RTMP_PORT=1935

# ── CORS — production domain(s) ───────────────────────────────────────────────
# Example: https://omnijoy.example.com
CORS_ORIGINS=

# ── MinIO (S3-compatible object storage for user-uploaded media) ─────────────
# Production stores avatars, post images/videos and chat attachments here.
# The bundled MinIO container is reached internally at http://minio:9000 by
# the backend (the compose service name "minio" is used as a DNS alias —
# the container_name 07ad0b82_omnijoy_minio contains underscores which some
# S3 clients reject). Clients fetch objects through nginx at /media/*
# (see docker/nginx.prod.conf.template).
#
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD double as the S3 access key / secret
# used by the backend's S3MediaStorageService.
# MINIO_BUCKET is also passed to the nginx service and substituted into
# nginx.prod.conf.template at container start via envsubst — no manual edits
# to the nginx config are needed when changing the bucket name.
MINIO_ROOT_USER=omnijoy
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=omnijoy

# ── Redis ─────────────────────────────────────────────────────────────────────
# SignalR backplane + distributed cache (token blacklist, rate-limit counters).
# Format: host:port[,password=…][,ssl=true]
# In production the container name is used; in dev use localhost:6379.
# Leave blank to fall back to in-memory cache (single-node only).
REDIS_CONNECTION=07ad0b82_omnijoy_redis:6379

# ── OAuth (optional — leave blank to disable) ────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_APP_ID=
OAUTH_FACEBOOK_APP_SECRET=

# ── Email / SMTP (optional) ────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_FROM_ADDRESS=noreply@omnijoy.local
SMTP_FROM_NAME=Omnijoy

# ── Rate limiting (optional overrides) ────────────────────────────────────────
# Production defaults (set in code by RateLimitConstants):
#   GlobalLimiter   : 200 req/min per IP (unauth) | 600 req/min per userId (auth)
#   Strict policy   :  10 req/min per IP  — auth endpoints (login, register, …)
#   Upload policy   :  20 req/hour per userId — POST media/avatar/cover/messages
#
# Override here only when needed. Key scenarios:
#   - `make test-e2e-prod` runs 300+ API requests per user in under 60 s,
#     exhausting the 600/min global limit and causing cascading browser test
#     failures. Raise the global per-user limit for E2E runs.
#   - The upload policy (20/hour) also needs relaxing for upload-heavy suites.
# Examples (uncomment to enable for E2E):
#   RATELIMIT_GLOBAL_USER_PERMITS=6000
#   RATELIMIT_GLOBAL_IP_PERMITS=2000
#   RATELIMIT_UPLOAD_PERMITS=1000
#   RATELIMIT_UPLOAD_WINDOW_SECONDS=3600
#   RATELIMIT_STRICT_PERMITS=200
#   RATELIMIT_STRICT_WINDOW_SECONDS=60
