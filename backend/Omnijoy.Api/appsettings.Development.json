{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=omnijoy;User=omnijoy;Password=omnijoy_pass;"
  },
  "Live": {
    "RtmpHost": "localhost",
    "RtmpPort": "1935",
    "HlsBaseUrl": "http://localhost:8888",
    "EnableRecording": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RateLimiting": {
    "// Note": "Development/E2E overrides. Production sticks to the defaults in RateLimitConstants (20 uploads/hour per user). The E2E suite makes ~50+ upload-type requests per user per run; bumping these to a generous ceiling keeps the suite from cascade-failing on 429.",
    "Upload": {
      "PermitLimit": 1000,
      "WindowSeconds": 3600
    },
    "Strict": {
      "PermitLimit": 200,
      "WindowSeconds": 60
    },
    "Global": {
      "UserPermitLimit": 6000,
      "IpPermitLimit": 2000,
      "WindowSeconds": 60
    }
  }
}
