# ── .NET ──────────────────────────────────────────────────────────────────────
bin/
obj/
*.user
*.suo
.vs/
*.csproj.user
TestResults/
coverage/
*.coverage
lcov.info

# Published output
backend/Omnijoy.Api/wwwroot/

# EF Core migrations (keep Migrations/ folder but ignore snapshot overrides)
# backend/**/Migrations/

# Secrets — never commit
# Note: appsettings.Production.json IS committed — it contains only non-secret
# production defaults (container names, log levels).  Real secrets (DB password,
# JWT key) are injected at runtime via docker-compose env vars from docker/.env.
**/appsettings.Secrets.json

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/coverage/
.npm
*.log
npm-debug.log*

# ── Docker ────────────────────────────────────────────────────────────────────
docker/.env

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.orig

# ── Temp build artifacts ──────────────────────────────────────────────────────
/tmp/omnijoy_*

# ── E2E test artifacts ────────────────────────────────────────────────────────
# Auth-token cache — written by globalSetup, contains JWTs (rotated each run).
e2e/.auth/
